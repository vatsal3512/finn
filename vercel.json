{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "app/",
      "framework": "nextjs",
      "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in data:*) exit 0;; *) exit 1;; esac"
    },
    "api": {
      "root": "backend/",
      "entrypoint": "finn.api:app",
      "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in data:*) exit 0;; *) exit 1;; esac"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
