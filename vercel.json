{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git -C \"$(git rev-parse --show-toplevel)\" diff --quiet HEAD^ HEAD -- . ':(exclude)app/public/data'",
  "services": {
    "app": { "root": "app/", "framework": "nextjs" },
    "api": { "root": "backend/", "entrypoint": "finn.api:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
