{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": { "root": "app/", "framework": "nextjs" },
    "api": { "root": "backend/", "entrypoint": "finn.api:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
