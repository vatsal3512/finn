# Copy this file to backend/.env and fill in your keys. backend/.env is git-ignored.
# Never paste keys into chats, issues or commits.
#
# Keys are tried in the order listed. When one hits a limit it rests: about a minute for
# a per-minute limit, or until midnight Pacific time for a daily quota.

# Google AI Studio keys, comma-separated: https://aistudio.google.com/apikey
GEMINI_API_KEYS=

# Groq keys, comma-separated, used only for text tasks when no Gemini key can answer
GROQ_API_KEYS=
