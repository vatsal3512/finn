     "type": "string"
    },
    "verdict_by": {
     "enum": [
      "code",
      "model"
     ],
     "type": "string"
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
