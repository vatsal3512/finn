    },
    "target": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "e.g. \"\u2265 \u20b94,000 crore\" or \"1\u20132% (constant currency)\""
    },
    "statement": {
     "type": "string"
    },
    "said": {
     "$ref": "#/$defs/Evidence"
    },
    "repeated_in": {
     "description": "later calls that repeated it",
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "revised_from": {
     "description": "earlier targets for the same metric and period, oldest first",
     "items": {
      "$ref": "#/$defs/Revision"
     },
     "type": "array"
    },
    "actual": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
