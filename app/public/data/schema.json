{
 "portfolio": {
  "$defs": {
   "Holding": {
    "properties": {
     "symbol": {
      "title": "Symbol",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "sector": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sector"
     },
     "size": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Size"
     },
     "last_date": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Date"
     },
     "close": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Close"
     },
     "ret_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Ret Pct"
     },
     "vol_ratio": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Vol Ratio"
     },
     "series": {
      "items": {
       "$ref": "#/$defs/PricePoint"
      },
      "title": "Series",
      "type": "array"
     },
     "source_url": {
      "title": "Source Url",
      "type": "string"
     }
    },
    "required": [
     "symbol",
     "name",
     "sector",
     "size",
     "last_date",
     "close",
     "ret_pct",
     "vol_ratio",
     "series",
     "source_url"
    ],
    "title": "Holding",
    "type": "object"
   },
   "PricePoint": {
    "properties": {
     "date": {
      "title": "Date",
      "type": "string"
     },
     "close": {
      "title": "Close",
      "type": "number"
     },
     "ret_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Close-to-close move, percent",
      "title": "Ret Pct"
     },
     "vol_ratio": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Volume over the prior 20-session mean",
      "title": "Vol Ratio"
     },
     "corp_action": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Set when the move is a corporate action",
      "title": "Corp Action"
     }
    },
    "required": [
     "date",
     "close"
    ],
    "title": "PricePoint",
    "type": "object"
   }
  },
  "properties": {
   "holdings": {
    "items": {
     "$ref": "#/$defs/Holding"
    },
    "title": "Holdings",
    "type": "array"
   }
  },
  "required": [
   "holdings"
  ],
  "title": "Portfolio",
  "type": "object"
 },
 "filings": {
  "$defs": {
   "Filing": {
    "properties": {
     "id": {
      "title": "Id",
      "type": "string"
     },
     "symbol": {
      "title": "Symbol",
      "type": "string"
     },
     "exchange": {
      "title": "Exchange",
      "type": "string"
     },
     "filed_at": {
      "title": "Filed At",
      "type": "string"
     },
     "exchange_label": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Exchange Label"
     },
     "headline": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Headline"
     },
     "category": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Category"
     },
     "tier": {
      "anyOf": [
       {
        "enum": [
         "must_see",
         "glance",
         "routine"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Tier"
     },
     "classified_by": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "rule, ai, or null when not yet sorted",
      "title": "Classified By"
     },
     "rule": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Rule"
     },
     "needs_ai": {
      "title": "Needs Ai",
      "type": "boolean"
     },
     "text_quality": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Text Quality"
     },
     "attachment_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Attachment Url"
     },
     "source_url": {
      "title": "Source Url",
      "type": "string"
     },
     "insight": {
      "anyOf": [
       {
        "$ref": "#/$defs/Insight"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "events": {
      "description": "Every event in the filing, lead first",
      "items": {
       "type": "string"
      },
      "title": "Events",
      "type": "array"
     },
     "cards": {
      "description": "On the group lead only, merged across the group",
      "items": {
       "anyOf": [
        {
         "$ref": "#/$defs/ResultsCard"
        },
        {
         "$ref": "#/$defs/PeopleCard"
        }
       ]
      },
      "title": "Cards",
      "type": "array"
     },
     "price_reaction": {
      "anyOf": [
       {
        "$ref": "#/$defs/PriceReaction"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "score": {
      "default": 0,
      "description": "Priority for Today's 3: higher shows first",
      "title": "Score",
      "type": "number"
     },
     "group_id": {
      "description": "Filings about the same event share a group",
      "title": "Group Id",
      "type": "string"
     },
     "group_lead": {
      "default": true,
      "description": "The one filing of its group to show; the rest are attachments",
      "title": "Group Lead",
      "type": "boolean"
     },
     "duplicate_of": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Set when this is a copy of an earlier filing's letter",
      "title": "Duplicate Of"
     }
    },
    "required": [
     "id",
     "symbol",
     "exchange",
     "filed_at",
     "exchange_label",
     "headline",
     "category",
     "tier",
     "classified_by",
     "rule",
     "needs_ai",
     "text_quality",
     "attachment_url",
     "source_url",
     "group_id"
    ],
    "title": "Filing",
    "type": "object"
   },
   "Insight": {
    "properties": {
     "title": {
      "title": "Title",
      "type": "string"
     },
     "summary": {
      "title": "Summary",
      "type": "string"
     },
     "why_it_matters": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Why It Matters"
     },
     "sentiment": {
      "enum": [
       "positive",
       "negative",
       "neutral",
       "mixed"
      ],
      "title": "Sentiment",
      "type": "string"
     },
     "amount_inr_crore": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Amount Inr Crore"
     },
     "model": {
      "title": "Model",
      "type": "string"
     }
    },
    "required": [
     "title",
     "summary",
     "why_it_matters",
     "sentiment",
     "amount_inr_crore",
     "model"
    ],
    "title": "Insight",
    "type": "object"
   },
   "Metric": {
    "properties": {
     "key": {
      "title": "Key",
      "type": "string"
     },
     "label": {
      "title": "Label",
      "type": "string"
     },
     "current": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Current"
     },
     "previous_quarter": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Previous Quarter"
     },
     "year_ago": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Year Ago"
     },
     "qoq_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Qoq Pct"
     },
     "yoy_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Yoy Pct"
     }
    },
    "required": [
     "key",
     "label",
     "current",
     "previous_quarter",
     "year_ago",
     "qoq_pct",
     "yoy_pct"
    ],
    "title": "Metric",
    "type": "object"
   },
   "PeopleCard": {
    "properties": {
     "type": {
      "const": "people",
      "default": "people",
      "title": "Type",
      "type": "string"
     },
     "changes": {
      "items": {
       "$ref": "#/$defs/PersonChange"
      },
      "title": "Changes",
      "type": "array"
     }
    },
    "required": [
     "changes"
    ],
    "title": "PeopleCard",
    "type": "object"
   },
   "PersonChange": {
    "properties": {
     "person": {
      "title": "Person",
      "type": "string"
     },
     "role": {
      "title": "Role",
      "type": "string"
     },
     "change": {
      "enum": [
       "appointment",
       "reappointment",
       "resignation",
       "retirement",
       "cessation",
       "redesignation",
       "other"
      ],
      "title": "Change",
      "type": "string"
     },
     "effective_date": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Effective Date"
     },
     "reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Reason"
     },
     "profile": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Bio taken from the filing's own profile section",
      "title": "Profile"
     },
     "previous_roles": {
      "items": {
       "type": "string"
      },
      "title": "Previous Roles",
      "type": "array"
     },
     "education": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Education"
     },
     "profile_source": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Filing id the profile came from, if not this one",
      "title": "Profile Source"
     }
    },
    "required": [
     "person",
     "role",
     "change"
    ],
    "title": "PersonChange",
    "type": "object"
   },
   "PriceReaction": {
    "properties": {
     "session": {
      "title": "Session",
      "type": "string"
     },
     "ret_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Ret Pct"
     },
     "vol_ratio": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Vol Ratio"
     }
    },
    "required": [
     "session",
     "ret_pct",
     "vol_ratio"
    ],
    "title": "PriceReaction",
    "type": "object"
   },
   "ResultsCard": {
    "description": "Headline numbers for one quarter versus last quarter and a year ago, in rupees crore.",
    "properties": {
     "type": {
      "const": "results",
      "default": "results",
      "title": "Type",
      "type": "string"
     },
     "symbol": {
      "title": "Symbol",
      "type": "string"
     },
     "period_end": {
      "title": "Period End",
      "type": "string"
     },
     "period_label": {
      "description": "Indian financial-year quarter, e.g. Q2 FY27",
      "title": "Period Label",
      "type": "string"
     },
     "basis": {
      "title": "Basis",
      "type": "string"
     },
     "kind": {
      "enum": [
       "standard",
       "bank"
      ],
      "title": "Kind",
      "type": "string"
     },
     "unit": {
      "default": "\u20b9 crore",
      "title": "Unit",
      "type": "string"
     },
     "metrics": {
      "items": {
       "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
     },
     "margin_label": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Margin Label"
     },
     "margin_pct": {
      "description": "current, previous quarter, year ago",
      "items": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": "Margin Pct",
      "type": "array"
     },
     "source": {
      "enum": [
       "xbrl",
       "filing_text",
       "filing_image",
       "screener"
      ],
      "title": "Source",
      "type": "string"
     },
     "verified": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "True when it matches screener.in, False on a mismatch",
      "title": "Verified"
     },
     "check_note": {
      "title": "Check Note",
      "type": "string"
     },
     "share_of_associates": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Reported separately from PBT in the filing; shown so the check is transparent",
      "title": "Share Of Associates"
     },
     "source_urls": {
      "items": {
       "type": "string"
      },
      "title": "Source Urls",
      "type": "array"
     }
    },
    "required": [
     "symbol",
     "period_end",
     "period_label",
     "basis",
     "kind",
     "metrics",
     "source",
     "check_note",
     "source_urls"
    ],
    "title": "ResultsCard",
    "type": "object"
   }
  },
  "properties": {
   "filings": {
    "items": {
     "$ref": "#/$defs/Filing"
    },
    "title": "Filings",
    "type": "array"
   }
  },
  "required": [
   "filings"
  ],
  "title": "Filings",
  "type": "object"
 },
 "meta": {
  "$defs": {
   "AIStats": {
    "properties": {
     "calls": {
      "title": "Calls",
      "type": "integer"
     },
     "input_tokens": {
      "title": "Input Tokens",
      "type": "integer"
     },
     "output_tokens": {
      "title": "Output Tokens",
      "type": "integer"
     },
     "by_model": {
      "additionalProperties": {
       "type": "integer"
      },
      "title": "By Model",
      "type": "object"
     },
     "cached_answers": {
      "title": "Cached Answers",
      "type": "integer"
     }
    },
    "required": [
     "calls",
     "input_tokens",
     "output_tokens",
     "by_model",
     "cached_answers"
    ],
    "title": "AIStats",
    "type": "object"
   },
   "AlertDefaults": {
    "properties": {
     "price_move_pct": {
      "title": "Price Move Pct",
      "type": "number"
     },
     "volume_multiple": {
      "title": "Volume Multiple",
      "type": "number"
     },
     "volume_baseline_sessions": {
      "title": "Volume Baseline Sessions",
      "type": "integer"
     }
    },
    "required": [
     "price_move_pct",
     "volume_multiple",
     "volume_baseline_sessions"
    ],
    "title": "AlertDefaults",
    "type": "object"
   }
  },
  "properties": {
   "schema_version": {
    "default": 3,
    "title": "Schema Version",
    "type": "integer"
   },
   "generated_at": {
    "title": "Generated At",
    "type": "string"
   },
   "latest_session": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Latest Session"
   },
   "filings_window_days": {
    "title": "Filings Window Days",
    "type": "integer"
   },
   "counts": {
    "additionalProperties": {
     "type": "integer"
    },
    "title": "Counts",
    "type": "object"
   },
   "alert_defaults": {
    "$ref": "#/$defs/AlertDefaults"
   },
   "ai": {
    "anyOf": [
     {
      "$ref": "#/$defs/AIStats"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "sources": {
    "items": {
     "type": "string"
    },
    "title": "Sources",
    "type": "array"
   }
  },
  "required": [
   "generated_at",
   "latest_session",
   "filings_window_days",
   "counts",
   "alert_defaults",
   "sources"
  ],
  "title": "Meta",
  "type": "object"
 }
}